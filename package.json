{
   "name": "eslint-plugin-kaezon",
   "version": "1.0.0",
   "description": "ESLint 10 flat-config plugin with custom TypeScript and Vue rules.",
   "keywords": [
      "eslint",
      "eslintplugin",
      "eslint-plugin",
      "flat-config",
      "typescript",
      "vue",
      "nuxt",
      "linting"
   ],
   "homepage": "https://github.com/svaldivia12/eslint-plugin-kaezon#readme",
   "bugs": {
      "url": "https://github.com/svaldivia12/eslint-plugin-kaezon/issues"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/svaldivia12/eslint-plugin-kaezon.git"
   },
   "license": "MIT",
   "author": {
      "name": "Sebastián Valdivia Loyola",
      "email": "admin@svaldivia.cl",
      "url": "https://github.com/svaldivia12"
   },
   "type": "module",
   "sideEffects": false,
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js",
         "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
   },
   "files": [
      "dist/**",
      "README.md",
      "CHANGELOG.md"
   ],
   "packageManager": "pnpm@12.16.1",
   "engines": {
      "node": ">=26"
   },
   "publishConfig": {
      "access": "public",
      "provenance": true
   },
   "peerDependencies": {
      "@typescript-eslint/eslint-plugin": "^8.0.0",
      "eslint": "^10.0.0",
      "eslint-plugin-vue": "^10.0.0",
      "typescript": ">=5"
   },
   "peerDependenciesMeta": {
      "@typescript-eslint/eslint-plugin": {
         "optional": true
      },
      "eslint-plugin-vue": {
         "optional": true
      }
   },
   "scripts": {
      "build": "tsc --project tsconfig.json",
      "lint": "eslint .",
      "typecheck": "tsc --project tsconfig.test.json",
      "test": "node --test tests/**/*.test.ts",
      "check:package": "publint && attw --pack . --profile esm-only",
      "prepublishOnly": "pnpm run build && pnpm run lint && pnpm run test && pnpm run typecheck && pnpm run check:package"
   },
   "devDependencies": {
      "@arethetypeswrong/cli": "^0.18.5",
      "@eslint/js": "^10.0.1",
      "@types/node": "^26.6.6",
      "@typescript-eslint/eslint-plugin": "^8.72.1",
      "@typescript-eslint/parser": "^8.72.1",
      "@typescript-eslint/utils": "^8.72.1",
      "eslint": "^10.14.0",
      "eslint-plugin-vue": "^10.12.0",
      "globals": "^17.13.0",
      "publint": "^0.3.25",
      "typescript": "~7.0.2",
      "vue-eslint-parser": "^10.4.1"
   }
}
