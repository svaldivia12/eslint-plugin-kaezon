{
   "name": "eslint-plugin-kaezon",
   "version": "1.0.0",
   "description": "ESLint 10 flat-config plugin with custom TypeScript and Vue rules.",
   "type": "module",
   "exports": {
      ".": {
         "types": "./index.d.ts",
         "import": "./index.js",
         "default": "./index.js"
      }
   },
   "files": [
      "index.js",
      "index.d.ts",
      "configs/**",
      "eslint-rules/**",
      "README.md"
   ],
   "packageManager": "pnpm@11.23.0",
   "engines": {
      "node": ">=26",
      "pnpm": ">=11"
   },
   "peerDependencies": {
      "eslint": "^10.0.0",
      "typescript": ">=5"
   },
   "scripts": {
      "test": "node --test tests/**/*.test.js"
   },
   "devDependencies": {
      "@typescript-eslint/parser": "^8.72.1",
      "eslint": "^10.14.0",
      "typescript": "~6.0.3",
      "vue-eslint-parser": "^10.4.1"
   }
}
